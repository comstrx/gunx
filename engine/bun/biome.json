{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "root": true,
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.bun", "!bun.lock", "!**/*.d.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "test": "all"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUndeclaredDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "a11y": "error",
      "security": {
        "recommended": true
      },
      "complexity": {
        "recommended": true,
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 6
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/tool/**", "!src/fs/**", "!src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "members are runtime-agnostic",
                  "process": "members are runtime-agnostic",
                  "Buffer": "members are runtime-agnostic",
                  "require": "members are runtime-agnostic"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["bun", "bun:*", "bun:*/**", "node:*", "node:*/**"],
                    "message": "members are runtime-agnostic"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
