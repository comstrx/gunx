{
  "name": "engine-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TypeScript engine: one Bun workspace, one member per domain.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "src/*"
  ],
  "catalog": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "mitata": "1.0.34",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "dependencies": {
    "engine": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fast-check": "catalog:",
    "mitata": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "check": "tsc -p .",
    "lint": "biome ci .",
    "test": "bun test ./tests --coverage && bun tests/coverage.ts",
    "fuzz": "bun test ./fuzz",
    "bench": "for file in benches/*.bench.ts; do bun \"$file\" || exit 1; done",
    "audit": "bun audit --audit-level=low",
    "gate": "bun install --frozen-lockfile && bun run link && bun run check && bun run lint && bun run test && bun run fuzz && bun run audit",
    "link": "BUN_INSTALL_GLOBAL_DIR=\"$(pwd)/.bun\" sh -c 'cd src/engine && bun link && cd ../../node_modules/react && bun link && cd ../react-dom && bun link'",
    "record": "bun tests/record.ts"
  }
}
