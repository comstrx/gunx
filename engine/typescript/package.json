{
  "name": "engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TypeScript engine: one Bun workspace, one member per domain.",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "src/*"
  ],
  "catalog": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "mitata": "1.0.34",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "unicode-segmenter": "0.17.3"
  },
  "exports": {
    ".": {
      "browser": "./src/engine/src/runtime.ts",
      "react-native": "./src/engine/src/runtime.ts",
      "default": "./src/engine/src/index.ts"
    },
    "./api": "./src/engine/src/api.ts",
    "./auth": "./src/engine/src/auth.ts",
    "./cache": "./src/engine/src/cache.ts",
    "./crypto": "./src/engine/src/crypto.ts",
    "./date": "./src/engine/src/date.ts",
    "./device": "./src/engine/src/device.ts",
    "./error": "./src/engine/src/error.ts",
    "./event": "./src/engine/src/event.ts",
    "./exception": "./src/engine/src/exception.ts",
    "./fake": "./src/engine/src/fake.ts",
    "./form": "./src/engine/src/form.ts",
    "./fs": "./src/engine/src/fs.ts",
    "./func": "./src/engine/src/func.ts",
    "./geo": "./src/engine/src/geo.ts",
    "./history": "./src/engine/src/history.ts",
    "./json": "./src/engine/src/json.ts",
    "./list": "./src/engine/src/list.ts",
    "./log": "./src/engine/src/log.ts",
    "./media": "./src/engine/src/media.ts",
    "./net": "./src/engine/src/net.ts",
    "./number": "./src/engine/src/number.ts",
    "./parse": "./src/engine/src/parse.ts",
    "./queue": "./src/engine/src/queue.ts",
    "./rand": "./src/engine/src/rand.ts",
    "./search": "./src/engine/src/search.ts",
    "./seo": "./src/engine/src/seo.ts",
    "./socket": "./src/engine/src/socket.ts",
    "./spec": "./src/engine/src/spec.ts",
    "./state": "./src/engine/src/state.ts",
    "./string": "./src/engine/src/string.ts",
    "./test": "./src/engine/src/test.ts",
    "./tool": "./src/engine/src/tool.ts",
    "./translate": "./src/engine/src/translate.ts",
    "./validate": "./src/engine/src/validate.ts",
    "./value": "./src/engine/src/value.ts",
    "./virtual": "./src/engine/src/virtual.ts",
    "./world": "./src/engine/src/world.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "engine-api": "file:./src/api",
    "engine-auth": "file:./src/auth",
    "engine-cache": "file:./src/cache",
    "engine-crypto": "file:./src/crypto",
    "engine-date": "file:./src/date",
    "engine-device": "file:./src/device",
    "engine-error": "file:./src/error",
    "engine-event": "file:./src/event",
    "engine-exception": "file:./src/exception",
    "engine-fake": "file:./src/fake",
    "engine-form": "file:./src/form",
    "engine-fs": "file:./src/fs",
    "engine-func": "file:./src/func",
    "engine-geo": "file:./src/geo",
    "engine-history": "file:./src/history",
    "engine-json": "file:./src/json",
    "engine-list": "file:./src/list",
    "engine-log": "file:./src/log",
    "engine-media": "file:./src/media",
    "engine-net": "file:./src/net",
    "engine-number": "file:./src/number",
    "engine-parse": "file:./src/parse",
    "engine-queue": "file:./src/queue",
    "engine-rand": "file:./src/rand",
    "engine-search": "file:./src/search",
    "engine-seo": "file:./src/seo",
    "engine-socket": "file:./src/socket",
    "engine-spec": "file:./src/spec",
    "engine-state": "file:./src/state",
    "engine-string": "file:./src/string",
    "engine-test": "file:./src/test",
    "engine-tool": "file:./src/tool",
    "engine-translate": "file:./src/translate",
    "engine-validate": "file:./src/validate",
    "engine-value": "file:./src/value",
    "engine-virtual": "file:./src/virtual",
    "engine-world": "file:./src/world",
    "mitata": "1.0.34",
    "unicode-segmenter": "0.17.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "check": "tsc -p .",
    "lint": "biome ci .",
    "test": "bun test ./tests",
    "fuzz": "bun test ./fuzz",
    "bench": "for file in benches/*.bench.ts; do bun \"$file\" || exit 1; done",
    "audit": "bun audit --audit-level=low",
    "gate": "bun install --frozen-lockfile && bun run link && bun run check && bun run lint && bun run test && bun run fuzz && bun run audit",
    "link": "BUN_INSTALL_GLOBAL_DIR=\"$(pwd)/.bun\" bun link"
  }
}
