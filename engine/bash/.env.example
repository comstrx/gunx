# Identity: the project this deployment serves and the release it runs

PROJECT=
RELEASE=

# Logging: the lowest level printed (debug, info, warn, error)

LOG_LEVEL=info

# Runs: the default budget in seconds of a command and of one I/O call, its retries and the backoff between them

RUN_TIMEOUT=600
RUN_RETRIES=3
RUN_BACKOFF=2

# Proofs: the budget of one test in seconds and the slowdown a bench may show over its baseline

TEST_TIMEOUT=120
BENCH_TOLERANCE=25

# Notify: the channels a run reports to; a channel is on when its settings are set

NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_EMAIL_SMTP_URL=
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
