# Identity: the project this deployment serves and the release it runs

PROJECT=
RELEASE=

# Logging: the lowest level printed (debug, info, warn, error)

LOG_LEVEL=info

# Runs: the budget of one I/O call in seconds, its retries and the backoff between them

RUN_TIMEOUT=300
RUN_RETRIES=3
RUN_BACKOFF=2

# Proofs: the budget of one test in seconds and the slowdown a bench may show over its baseline

TEST_TIMEOUT=120
BENCH_TOLERANCE=25
