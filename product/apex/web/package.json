{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The web and desktop surfaces: every role from its spec, on Next or in an Electrobun window.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "engine": "link:engine",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lock": "BUN_INSTALL_GLOBAL_DIR=\"$(cd ../../../engine/typescript && pwd)/.bun\" bun install --lockfile-only",
    "deps": "(cd ../../../engine/typescript && bun install --frozen-lockfile && bun run link) && BUN_INSTALL_GLOBAL_DIR=\"$(cd ../../../engine/typescript && pwd)/.bun\" bun install --frozen-lockfile",
    "check": "bun tool.config.ts check",
    "lint": "bun tool.config.ts lint",
    "test": "bun tool.config.ts test",
    "build": "bun tool.config.ts build",
    "release": "bun tool.config.ts release",
    "dev": "bun tool.config.ts dev",
    "audit": "bun tool.config.ts audit",
    "gate": "bun run deps && bun tool.config.ts gate"
  }
}
