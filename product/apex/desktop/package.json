{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The desktop surface: every office role from its spec, in an Electrobun window.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "engine": "link:engine",
    "react": "link:react",
    "react-dom": "link:react-dom"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "deps": "BUN_INSTALL_GLOBAL_DIR=\"$(cd ../../../engine/bun && pwd)/.bun\" bun install --frozen-lockfile && bun run --cwd native deps",
    "tool": "bun node_modules/engine/bin/tool.ts",
    "compile": "bun run tool compile",
    "check": "bun run tool check",
    "lint": "bun run tool lint",
    "test": "bun run tool test",
    "build": "bun run tool build",
    "release": "bun run tool release",
    "app": "bun run tool app",
    "dev": "bun run tool dev",
    "audit": "bun run tool audit",
    "native": "bun run --cwd native",
    "gate": "bun run deps && bun run tool gate"
  }
}
