{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "The mobile surface: every native role from its spec, on Expo over the engine.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "engine": "link:engine",
    "expo": "58.0.23",
    "expo-audio": "58.0.11",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-crypto": "58.0.7",
    "expo-document-picker": "58.0.4",
    "expo-haptics": "58.0.8",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-location": "58.0.22",
    "expo-notifications": "58.1.9",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.4",
    "expo-video": "58.0.13",
    "react": "link:react",
    "react-dom": "link:react-dom",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "scripts": {
    "deps": "BUN_INSTALL_GLOBAL_DIR=\"$(cd ../../../engine/bun && pwd)/.bun\" bun install --frozen-lockfile",
    "tool": "bun node_modules/engine/bin/tool.ts",
    "compile": "bun run tool compile",
    "check": "bun run tool check",
    "lint": "bun run tool lint",
    "test": "bun run tool test",
    "build": "bun run tool build",
    "release": "bun run tool release",
    "start": "bun run tool start",
    "audit": "bun run tool audit",
    "gate": "bun run deps && bun run tool gate"
  }
}
