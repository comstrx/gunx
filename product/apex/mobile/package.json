{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "The mobile surface: every native role from its spec, on Expo over the engine.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "engine": "link:engine",
    "expo": "58.0.23",
    "expo-crypto": "58.0.7",
    "expo-status-bar": "58.0.4",
    "react": "link:react",
    "react-dom": "link:react-dom",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "scripts": {
    "deps": "BUN_INSTALL_GLOBAL_DIR=\"$(cd ../../../engine/bun && pwd)/.bun\" bun install --frozen-lockfile",
    "compile": "bun tools/compile.ts",
    "check": "bun tools/compile.ts && tsc -p . && bun tools/analyze.ts",
    "typecheck": "tsc -p .",
    "lint": "biome ci .",
    "test": "bun test ./tests",
    "start": "export EXPO_PUBLIC_API_URL=\"${EXPO_PUBLIC_API_URL:-${API_URL:-}}\" EXPO_PUBLIC_ENGINE_ENV=\"${EXPO_PUBLIC_ENGINE_ENV:-${ENGINE_ENV:-}}\"; bun tools/compile.ts && expo start",
    "build": "bun tools/build.ts",
    "audit": "bun audit --audit-level=low",
    "gate": "bun run deps && bun run check && bun run lint && bun run test && bun run build && bun run audit"
  }
}
