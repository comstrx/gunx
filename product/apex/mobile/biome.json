{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!bun.lock",
      "!**/*.d.ts",
      "!dist",
      "!.expo",
      "!.cache",
      "!public"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "test": "all",
      "react": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowExportNames": [
              "metadata",
              "generateMetadata",
              "viewport",
              "dynamic",
              "revalidate"
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "a11y": "error",
      "security": {
        "preset": "recommended"
      },
      "complexity": {
        "preset": "recommended",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 6
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": [
      "Bun"
    ]
  },
  "overrides": [
    {
      "includes": [
        "tools/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/setup.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off",
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/features/**",
        "src/app/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          }
        }
      }
    }
  ]
}
